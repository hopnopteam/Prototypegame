{
  "name": "night-express",
  "version": "0.2.0",
  "private": true,
  "description": "Night Express: hybrid-casual arcade idle game. Run a luxury sleeper train that grows carriage by carriage.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "audit:ui": "node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
